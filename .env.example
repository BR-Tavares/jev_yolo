# ==============================================================================
# JEV + YOLO Time Series Analytics - Environment Configuration
# ==============================================================================

# Chave de API da OpenRouter (obrigatória para inferência real com o Jev)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modelo Jev na OpenRouter (padrão: typesafe/jev-1.13)
JEV_MODEL=typesafe/jev-1.13

# Endpoint Alpha Decisions da OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha/decisions

# Título da Aplicação e Identificação de Origem HTTP
APP_TITLE=Jev YOLO Time Series Analytics
HTTP_REFERER=https://github.com/jev-yolo-analytics

# Configurações do Dashboard Streamlit
DASHBOARD_REFRESH_RATE_MS=1500
EMA_ALPHA=0.35
HISTORY_MAX_POINTS=120
